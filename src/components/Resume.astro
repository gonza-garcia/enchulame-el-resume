---
import type { LocalizedText, Locale } from '../schemas/profile';
import type { ResumeLocale } from '../schemas/resume';
import type { BilingualProjection } from '../lib/profile-projection';
import Layout from '../layouts/Layout.astro';
import Toolbar from './Toolbar.astro';
import OffersManager from '../islands/offers-manager/OffersManager';
import type { OfferView } from '../islands/offers-manager/contract';
import { SECTION_TITLES as sectionTitles, positioningLabel, clientBlock } from '../lib/resume-sections';

interface Props {
  projections: Record<string, BilingualProjection>;
  positionings: Array<{ id: string; title: LocalizedText }>;
  brandName: LocalizedText;
  brandMark: string;
  pdfTitle: string;
  adaptedViews: OfferView[];
  userName: string;
}
const { projections, positionings, brandName, brandMark, pdfTitle, adaptedViews, userName } = Astro.props;

const locales: Locale[] = ['en', 'es'];
const defaultPositioning = positionings[0];

const payload = {
  projections,
  positionings: positionings.map((positioning) => ({
    id: positioning.id,
    title: positioning.title,
    label: positioningLabel(positioning.id)
  })),
  brand: { mark: brandMark, name: brandName }
};
---

<Layout title={`${brandName.en} - ${defaultPositioning.title.en}`}>
  <Toolbar
    idPrefix=""
    brand={{ mark: brandMark, name: brandName.en, role: defaultPositioning.title.en }}
    pdfTitle={pdfTitle}
    showTheme={true}
    tip="Tip: pick a language, then Print PDF for an ATS-friendly single-column résumé."
  />

  {/* Tabs de "Mis perfiles" (Fase D): "CVs base" (default) y "CVs adaptados". Chrome de
      pantalla, oculto en print. El estado vive en html[data-cv-tab] y en ?tab=. */}
  <script is:inline>
    // Deep link canonico: ?tab=adaptados (se acepta tambien ?tab=adapted).
    const cvTabParam = new URLSearchParams(window.location.search).get('tab');
    if (cvTabParam === 'adaptados' || cvTabParam === 'adapted') {
      document.documentElement.setAttribute('data-cv-tab', 'adapted');
    }
  </script>
  <div class="cv-tabs" role="tablist" aria-label="Mis perfiles">
    <button type="button" class="cv-tab" role="tab" id="cv-tab-base" data-cv-tab-target="base" aria-controls="cv-panel-base" aria-selected="true">CVs base</button>
    <button type="button" class="cv-tab" role="tab" id="cv-tab-adapted" data-cv-tab-target="adapted" aria-controls="cv-panel-adapted" aria-selected="false">CVs adaptados</button>
  </div>

  <div class="cv-panel" data-tab="base" id="cv-panel-base" role="tabpanel" aria-labelledby="cv-tab-base">
  <main class="page">
    {/* Cards por posicionamiento (Fase D): cada card selecciona la proyeccion activa
        del CV base y ofrece sus acciones. No se imprime (chrome de pantalla). */}
    <section class="cv-cards" aria-label="CVs base">
      {positionings.map((positioning) => {
        const initial = projections[positioning.id].en as ResumeLocale;
        return (
          <div class="cv-card" data-positioning={positioning.id}>
            <button
              type="button"
              class="cv-card-select"
              data-positioning={positioning.id}
              aria-pressed={positioning.id === defaultPositioning.id ? 'true' : 'false'}
            >
              <span class="cv-card-title">{positioning.title.en}</span>
              <span class="cv-card-summary">{initial.summary}</span>
            </button>
            <div class="cv-card-actions">
              <button type="button" class="cv-card-action" data-card-action="print">Imprimir PDF</button>
              <button type="button" class="cv-card-action" data-card-action="export">Exportar</button>
            </div>
          </div>
        );
      })}
    </section>
    {positionings.map((positioning) => locales.map((key) => {
      const data = projections[positioning.id][key] as ResumeLocale;
      return (
        <article
          class="lang"
          data-lang={key}
          data-positioning={positioning.id}
          aria-hidden={key !== 'en' || positioning.id !== defaultPositioning.id}
        >
          <header>
            <h1>{data.name}</h1>
            <p class="titleline">{data.title}</p>
            <p class="contactline">
              <span>{data.contact.phone}</span><span class="sep"> • </span>
              <span>{data.contact.email}</span><span class="sep"> • </span>
              <span>{data.contact.location}</span><span class="sep"> • </span>
              <span>{data.contact.linkedin}</span><span class="sep"> • </span>
              <span>{data.contact.github}</span>
            </p>
          </header>

          <section class="summary" aria-label={sectionTitles[key].summary}>
            <h2>{sectionTitles[key].summary}</h2>
            {data.summary.split('\n\n').map((para) => <p>{para}</p>)}
          </section>

          <section class="skills" aria-label={sectionTitles[key].skills}>
            <h2>{sectionTitles[key].skills}</h2>
            {data.skills.map((skill) => (
              <div class="skill-line">
                <span class="skill-cat">{skill.category}</span>
                <span class="skill-items">{skill.items}</span>
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].experience}>
            <h2>{sectionTitles[key].experience}</h2>
            {data.experience.map((job) => (
              <div class="job">
                <div class="job-head">
                  <div class="job-role">{job.role}</div>
                  <div class="job-company">{job.company}</div>
                  <div class="job-dates">{job.startDate} - {job.endDate}</div>
                </div>
                {job.projects.map((project) => (
                  <div class="subproject">
                    <ul class="bullets">
                      <li class="proj-line"><span aria-hidden="true">{'\u2022 '}</span>{clientBlock(project.name, project.startDate, project.endDate, key)}</li>
                      {project.url && <li class="proj-url"><span aria-hidden="true">{'- '}</span>{project.url}</li>}
                      {project.bullets.map((bullet) => <li class="bullet-item"><span aria-hidden="true">{'- '}</span>{bullet}</li>)}
                    </ul>
                  </div>
                ))}
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].education}>
            <h2>{sectionTitles[key].education}</h2>
            {data.education.map((edu) => (
              <div class="edu-entry">
                <div class="edu-head">
                  <span class="edu-name">{edu.institution} - {edu.degree}</span>
                  <span class="edu-dates">{edu.startDate} - {edu.endDate}</span>
                </div>
                {edu.note && <div class="edu-note">{edu.note}</div>}
              </div>
            ))}
          </section>

          <section aria-label={sectionTitles[key].certifications}>
            <h2>{sectionTitles[key].certifications}</h2>
            {data.certifications.map((cert) => (
              <div class="cert-entry">
                <div class="cert-head">
                  <span class="cert-name">{cert.name}</span>
                </div>
                {cert.note && <div class="cert-note">{cert.note}</div>}
              </div>
            ))}
          </section>

          {data.projects.length > 0 && (
            <section aria-label={sectionTitles[key].projects}>
              <h2>{sectionTitles[key].projects}</h2>
              {data.projects.map((project) => (
                <div class="proj-entry">
                  <div class="proj-head">
                    <span class="proj-name">{project.name}</span>
                    <span class="proj-meta">{[project.url, project.date].filter(Boolean).join(' | ')}</span>
                  </div>
                  <div class="proj-desc">{project.description}</div>
                </div>
              ))}
            </section>
          )}
        </article>
      );
    }))}
  </main>
  </div>

  <div class="cv-panel" data-tab="adapted" id="cv-panel-adapted" role="tabpanel" aria-labelledby="cv-tab-adapted">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown-light.css" />
    <OffersManager client:load offers={adaptedViews} isDev={import.meta.env.DEV} userName={userName} />
  </div>

  <script type="application/json" id="resume-data" is:inline set:html={JSON.stringify(payload)}></script>

  <script>
    import { LANG_STORAGE_KEY, POSITIONING_STORAGE_KEY } from '../scripts/storage-keys';

    type Locale = 'es' | 'en';

    interface Payload {
      projections: Record<string, Record<Locale, unknown>>;
      positionings: Array<{ id: string; title: Record<Locale, string>; label?: string }>;
      brand: { mark: string; name: Record<Locale, string> };
    }

    const dataEl = document.getElementById('resume-data');
    const payload: Payload = dataEl
      ? JSON.parse(dataEl.textContent || '{}')
      : { projections: {}, positionings: [], brand: { mark: '', name: { es: '', en: '' } } };

    const defaultPositioning = payload.positionings[0]?.id ?? '';

    function readStored(key: string, allowed: string[], fallback: string): string {
      try {
        const saved = localStorage.getItem(key);
        if (saved && allowed.includes(saved)) return saved;
      } catch {
        // localStorage no disponible
      }
      return fallback;
    }

    function currentLang(): Locale {
      return readStored(LANG_STORAGE_KEY, ['es', 'en'], 'en') as Locale;
    }

    function currentPositioning(): string {
      const ids = payload.positionings.map((positioning) => positioning.id);
      return readStored(POSITIONING_STORAGE_KEY, ids, defaultPositioning);
    }

    function applyState() {
      const lang = currentLang();
      const positioning = currentPositioning();

      // Solo los articulos del CV base (tienen data-positioning): los de la isla del
      // gestor de ofertas no se tocan o se rompe su hidratacion de React.
      for (const art of document.querySelectorAll('article.lang[data-positioning]')) {
        const on =
          art.getAttribute('data-lang') === lang && art.getAttribute('data-positioning') === positioning;
        art.classList.toggle('active', on);
        art.setAttribute('aria-hidden', String(!on));
      }

      (window as unknown as { __exportResume?: unknown }).__exportResume =
        payload.projections[positioning] ?? null;

      const nameEl = document.querySelector<HTMLElement>('.brand-name');
      if (nameEl) nameEl.textContent = payload.brand.name[lang] ?? payload.brand.name.en;
      const roleEl = document.querySelector<HTMLElement>('.brand-role');
      const active = payload.positionings.find((option) => option.id === positioning);
      if (roleEl && active) roleEl.textContent = active.title[lang] ?? active.title.en;

      for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-positioning]')) {
        const id = button.getAttribute('data-positioning');
        button.setAttribute('aria-pressed', String(id === positioning));
      }

      // Las cards de posicionamiento llevan estructura propia: se actualizan sus
      // textos al locale activo en vez de pisar el contenido del boton.
      for (const card of document.querySelectorAll<HTMLElement>('.cv-card[data-positioning]')) {
        const id = card.getAttribute('data-positioning') ?? '';
        const option = payload.positionings.find((candidate) => candidate.id === id);
        const titleEl = card.querySelector<HTMLElement>('.cv-card-title');
        const summaryEl = card.querySelector<HTMLElement>('.cv-card-summary');
        if (titleEl && option) titleEl.textContent = option.title[lang] ?? option.title.en;
        const projection = payload.projections[id]?.[lang] as { summary?: string } | undefined;
        if (summaryEl) summaryEl.textContent = projection?.summary ?? '';
      }
    }

    applyState();

    // Acciones por card: imprimen o exportan el CV del posicionamiento de esa card.
    for (const action of document.querySelectorAll<HTMLButtonElement>('[data-card-action]')) {
      action.addEventListener('click', (e) => {
        // El click no debe burbujear al listener global que cierra el menu de export.
        e.stopPropagation();
        const card = action.closest('.cv-card');
        const main = card?.querySelector<HTMLButtonElement>('button[data-positioning]');
        if (main && main.getAttribute('aria-pressed') !== 'true') main.click();
        if (action.getAttribute('data-card-action') === 'print') {
          document.querySelector<HTMLButtonElement>('[data-export="pdf"]')?.click();
        } else {
          document.dispatchEvent(new CustomEvent('toolbar:export-open'));
        }
      });
    }

    // ===== Tabs "CVs base" / "CVs adaptados" =====
    function activeTab(): 'base' | 'adapted' {
      return document.documentElement.getAttribute('data-cv-tab') === 'adapted' ? 'adapted' : 'base';
    }

    function selectTab(tab: 'base' | 'adapted', updateUrl = true) {
      document.documentElement.setAttribute('data-cv-tab', tab);
      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cv-tab-target]')) {
        button.setAttribute('aria-selected', String(button.getAttribute('data-cv-tab-target') === tab));
      }
      if (updateUrl) {
        const url = new URL(window.location.href);
        if (tab === 'adapted') url.searchParams.set('tab', 'adaptados');
        else url.searchParams.delete('tab');
        window.history.replaceState({}, '', url);
      }
    }

    // Sincroniza los botones con el estado inicial (el script inline lo leyo de ?tab=).
    selectTab(activeTab(), false);

    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-cv-tab-target]')) {
      button.addEventListener('click', () => {
        selectTab((button.getAttribute('data-cv-tab-target') as 'base' | 'adapted') ?? 'base');
      });
    }

    // La isla del gestor de ofertas pide volver a la tab del CV base.
    document.addEventListener('cv:tab-select', (e) => {
      selectTab((e as CustomEvent<{ tab: 'base' | 'adapted' }>).detail.tab);
    });

    document.addEventListener('toolbar:lang-change', () => applyState());
    document.addEventListener('toolbar:positioning-change', () => applyState());

    document.addEventListener('toolbar:export-json', () => {
      // El export JSON actua sobre el documento activo: en la tab de adaptados el
      // adapted-resume lo descarga la isla, aca solo la proyeccion del CV base.
      if (activeTab() !== 'base') return;
      const projection = payload.projections[currentPositioning()]?.[currentLang()];
      const blob = new Blob([JSON.stringify(projection ?? {}, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'resume.json';
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    });
  </script>
</Layout>
