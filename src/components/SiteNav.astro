---
/**
 * Navbar consistente del sitio (Fase D/F): brand + los 4 destinos, la misma pieza
 * en todas las páginas. Vive dentro del Toolbar en "Mis perfiles" y como barra
 * slim en `/ofertas`, `/interview` y `/learning`. Los destinos están fijos acá
 * para no repetirlos. Navbar como links con subrayado (regla de UI de la Fase F):
 * el activo queda subrayado, nunca pill.
 */
export interface SiteNavBrand {
  mark: string;
  name: string;
  role: string;
}

interface Props {
  brand: SiteNavBrand;
}

const { brand } = Astro.props;

const destinations = [
  { href: '/', label: 'Mis perfiles' },
  { href: '/ofertas/', label: 'Ofertas' },
  { href: '/interview/', label: 'Prep entrevistas' },
  { href: '/learning/', label: 'Plan de estudios' }
];

const normalize = (path: string) => path.replace(/\/+$/, '') || '/';
const currentPath = normalize(Astro.url.pathname);
const isActive = (href: string) => currentPath === normalize(href);
---

<a href="/" class="brand" aria-label="Mis perfiles">
  <span class="brand-mark">{brand.mark}</span>
  <span class="brand-text">
    <span class="brand-name">{brand.name}</span>
    <span class="brand-role">{brand.role}</span>
  </span>
</a>
<nav class="site-nav" aria-label="Site navigation">
  {destinations.map((link) => (
    <a
      class={`site-nav-link${isActive(link.href) ? ' active' : ''}`}
      href={link.href}
      aria-current={isActive(link.href) ? 'page' : undefined}
    >{link.label}</a>
  ))}
</nav>
