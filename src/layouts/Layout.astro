---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="navy" data-accents="name sections urls skills" data-cv-tab="base">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={title} />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('resume-theme');
          var a = localStorage.getItem('resume-accents');
          var c = localStorage.getItem('resume-theme-custom');
          if (t) document.documentElement.setAttribute('data-theme', t);
          if (a) document.documentElement.setAttribute('data-accents', a);
          if (t === 'custom' && c) document.documentElement.style.setProperty('--accent', c);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <slot />
    <style is:global>
      :root {
        --ink: #1a1a1a;
        --muted: #555;
        --rule: #d0d0d0;
        --bg: #ffffff;
        --accent: #1a365d;
      }
      :root[data-theme="navy"] { --accent: #1a365d; }
      :root[data-theme="teal"] { --accent: #0f4c4c; }
      :root[data-theme="charcoal"] { --accent: #333333; }
      :root[data-theme="custom"] { --accent: #1a365d; }

      html[data-accents~="name"] h1 { color: var(--accent); }
      html[data-accents~="sections"] h2 { color: var(--accent); border-bottom-color: var(--accent); }
      html[data-accents~="urls"] .bullets li.proj-url { color: var(--accent); }
      html[data-accents~="skills"] .skill-cat { color: var(--accent); }

      * { box-sizing: border-box; }

      html { -webkit-text-size-adjust: 100%; }

      body {
        margin: 0;
        background: #e9ecef;
        color: var(--ink);
        font-family: 'Helvetica Neue', Helvetica, Arial, Calibri, sans-serif;
        font-size: 11pt;
        line-height: 1.45;
        -webkit-font-smoothing: antialiased;
      }

      .page {
        max-width: 8.5in;
        margin: 24px auto;
        background: var(--bg);
        padding: 0.6in 0.7in;
        box-shadow: 0 2px 18px rgba(0,0,0,0.08);
      }

      /* Cards por posicionamiento del CV base (Fase D): selector + acciones.
         Chrome de pantalla: no se imprime. */
      .cv-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: 10px;
        margin: 0 0 18px;
      }
      .cv-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        border: 1px solid var(--rule);
        border-radius: 10px;
        padding: 10px 12px;
        background: var(--bg);
        transition: border-color 140ms ease-out, background 140ms ease-out;
      }
      .cv-card:has(.cv-card-select[aria-pressed="true"]) {
        border-color: color-mix(in srgb, var(--accent) 35%, white);
        background: color-mix(in srgb, var(--accent) 5%, white);
      }
      .cv-card-select {
        width: 100%;
        text-align: left;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-family: inherit;
        color: inherit;
      }
      .cv-card-title { display: block; font-weight: 700; font-size: 11pt; color: var(--ink); }
      .cv-card-summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 9.5pt;
        color: var(--muted);
        margin-top: 2px;
      }
      .cv-card-actions { display: flex; gap: 8px; }
      .cv-card-action {
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: 6px;
        padding: 5px 10px;
        font-family: inherit;
        font-size: 9pt;
        color: var(--ink);
        cursor: pointer;
        transition: background 140ms ease-out, color 140ms ease-out, border-color 140ms ease-out;
      }
      .cv-card-action:hover {
        background: color-mix(in srgb, var(--accent) 8%, white);
        color: var(--accent);
        border-color: color-mix(in srgb, var(--accent) 25%, white);
      }
      .cv-card-action:focus-visible, .cv-card-select:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .toolbar {
        margin: 0;
        padding: 0 20px;
        background: #fff;
        border-bottom: 1px solid var(--rule);
        box-shadow: 0 1px 0 rgba(10, 20, 40, 0.02), 0 8px 24px -12px rgba(10, 20, 40, 0.12);
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        align-items: center;
        min-height: 64px;
        position: sticky;
        top: 0;
        z-index: 50;
      }
      .toolbar::after {
        content: '';
        position: absolute;
        left: 0;
        right: 0;
        bottom: -1px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent), transparent 65%);
        opacity: 0.35;
        pointer-events: none;
      }
      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        margin-right: 4px;
      }
      .brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 9px;
        background: var(--accent);
        color: #fff;
        font-weight: 700;
        font-size: 11pt;
        letter-spacing: 0.02em;
        box-shadow: 0 2px 6px -1px rgba(10, 20, 40, 0.25);
        transition: transform 160ms ease-out, box-shadow 160ms ease-out;
      }
      .brand:hover .brand-mark {
        transform: translateY(-1px) rotate(-2deg);
        box-shadow: 0 4px 10px -2px rgba(10, 20, 40, 0.3);
      }
      .brand-text { display: flex; flex-direction: column; line-height: 1.15; }
      .brand-name { font-weight: 700; font-size: 10.5pt; color: var(--ink); }
      .brand-role { font-size: 8pt; color: var(--muted); letter-spacing: 0.04em; text-transform: uppercase; }
      .brand:hover .brand-name { color: var(--accent); }

      .toolbar button, .toolbar .toggle {
        font-family: inherit;
        font-size: 10pt;
        padding: 7px 12px;
        border: 1px solid var(--rule);
        background: #f7f7f7;
        color: var(--ink);
        border-radius: 6px;
        cursor: pointer;
        line-height: 1;
        transition: background 140ms ease-out, transform 140ms ease-out, box-shadow 140ms ease-out, color 140ms ease-out;
      }
      .toolbar button:hover { background: #efefef; transform: translateY(-1px); box-shadow: 0 2px 6px -2px rgba(10, 20, 40, 0.18); }
      .toolbar button:active { transform: translateY(0) scale(0.98); box-shadow: none; }
      .toolbar button:focus-visible, .brand:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .toolbar .spacer { flex: 1; }
      .toolbar .toggle { display: inline-flex; overflow: hidden; border-radius: 6px; }
      .toolbar .toggle button { border: 0; border-radius: 0; background: transparent; padding: 7px 14px; transition: background 140ms ease-out, color 140ms ease-out; }
      .toolbar .toggle button[aria-pressed="true"] { background: var(--accent); color: #fff; font-weight: 600; }
      .toolbar .toggle button:hover { transform: none; }

      /* Aviso de modo de build: no invasivo, se descarta con la x */
      .build-notice {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        max-width: 260px;
        padding: 4px 8px;
        border: 1px solid color-mix(in srgb, var(--accent) 26%, #ffffff);
        border-radius: 999px;
        background: color-mix(in srgb, var(--accent) 8%, #ffffff);
        color: #4a4f57;
        font-size: 11px;
        line-height: 1.3;
      }
      .build-notice-text { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .build-notice-close {
        border: 0;
        background: transparent;
        padding: 0 2px;
        font-size: 13px;
        line-height: 1;
        color: #6b7280;
        box-shadow: none;
      }
      .build-notice-close:hover { background: transparent; transform: none; box-shadow: none; color: #111827; }

      .site-nav { display: inline-flex; align-items: center; gap: 4px; }
      /* Navbar como links con subrayado (regla de UI de la Fase F): nunca pill ni
         rectangulo (eso es para acciones). El activo queda subrayado en accent. */
      .site-nav-link {
        display: inline-flex;
        align-items: center;
        min-height: 29px;
        padding: 6px 10px;
        color: var(--muted);
        background: transparent;
        font-size: 10pt;
        text-decoration: underline;
        text-decoration-color: transparent;
        text-decoration-thickness: 2px;
        text-underline-offset: 5px;
        transition: color 150ms ease, text-decoration-color 150ms ease;
      }
      .site-nav-link:hover { color: var(--ink); text-decoration-color: var(--rule); }
      .site-nav-link.active {
        color: var(--accent);
        font-weight: 600;
        text-decoration-color: var(--accent);
      }
      .site-nav-link:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

      .export-dropdown { position: relative; display: inline-block; }
      .export-dropdown > button .caret { display: inline-block; margin-left: 4px; font-size: 10pt; transition: transform 180ms ease-out; }
      .export-dropdown > button[aria-expanded="true"] .caret { transform: rotate(180deg); }
      .export-dropdown > button[aria-expanded="true"] {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
      }
      .export-menu {
        position: absolute;
        top: calc(100% + 6px);
        left: 0;
        min-width: 200px;
        background: #fff;
        border: 1px solid var(--rule);
        border-radius: 10px;
        box-shadow: 0 12px 32px -8px rgba(10, 20, 40, 0.22);
        padding: 4px;
        z-index: 30;
        opacity: 0;
        transform: translateY(-8px) scale(0.98);
        transition: opacity 140ms ease-out, transform 140ms ease-out;
        pointer-events: none;
      }
      .export-menu.open { opacity: 1; transform: translateY(0); pointer-events: auto; }
      .export-menu button {
        display: block;
        width: 100%;
        text-align: left;
        border: 0;
        background: transparent;
        padding: 7px 10px;
        font-family: inherit;
        font-size: 10pt;
        color: var(--ink);
        border-radius: 6px;
        transition: background 120ms ease-out, color 120ms ease-out;
      }
      .export-menu button:hover { background: color-mix(in srgb, var(--accent) 8%, white); color: var(--accent); }
      .export-menu button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
      .lang { display: none; }
      .lang.active { display: block; }

      h1 {
        font-size: 22pt;
        margin: 0 0 2px 0;
        letter-spacing: -0.01em;
        font-weight: 700;
      }
      .titleline {
        font-size: 13pt;
        color: var(--muted);
        margin: 0 0 8px 0;
        font-weight: 600;
      }
      .contactline {
        font-size: 9.5pt;
        color: var(--muted);
        margin: 0 0 4px 0;
        word-break: break-word;
      }
      .contactline a { color: var(--muted); text-decoration: none; }
      .contactline .sep { margin: 0 6px; color: #bbb; }

      section { margin-top: 16px; }
      h2 {
        font-size: 12.5pt;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        border-bottom: 1.5px solid var(--ink);
        padding-bottom: 3px;
        margin: 0 0 8px 0;
        font-weight: 700;
      }
      p { margin: 0 0 8px 0; }

      .summary p { margin: 0; }

      .skills .skill-line {
        display: flex;
        gap: 8px;
        margin-bottom: 3px;
        font-size: 10pt;
      }
      .skills .skill-cat {
        flex: 0 0 145px;
        font-weight: 700;
        color: var(--ink);
      }
      .skills .skill-items { flex: 1; }

      .job-head {
        margin-bottom: 6px;
      }
      .job-head .job-role {
        font-size: 11pt;
        font-weight: 700;
      }
      .job-head .job-company {
        font-size: 10.5pt;
        font-weight: 700;
      }
      .job-head .job-dates {
        font-size: 10pt;
        color: var(--muted);
      }
      .proj-label {
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8.5pt;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        color: var(--accent);
        margin-right: 6px;
      }

      .subproject { margin-bottom: 10px; break-inside: avoid; page-break-inside: avoid; }
      .bullets li.proj-line { font-weight: 700; margin-top: 6px; }
      .bullets li.bullet-item { margin-left: 14px; }
      .bullets li.proj-url { font-size: 9.5pt; color: var(--muted); margin-left: 14px; word-break: break-all; }
      ul.bullets {
        /* Los marcadores son caracteres literales en el texto (ADR-0039 v4): el
           marker de lista CSS no se copia ni aparece en la capa de texto del PDF. */
        list-style: none;
        padding-left: 18px;
        margin: 0;
      }
      ul.bullets li {
        margin-bottom: 4px;
        font-size: 10pt;
        line-height: 1.4;
      }

      .edu-entry, .cert-entry, .proj-entry { margin-bottom: 6px; }
      .edu-head, .cert-head, .proj-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: baseline;
      }
      .edu-name, .cert-name, .proj-name { font-weight: 700; font-size: 10.5pt; }
      .edu-dates, .proj-meta { font-size: 9.5pt; color: var(--muted); white-space: nowrap; }
      .edu-degree, .cert-note, .proj-desc { font-size: 10pt; }
      .edu-note { font-size: 9.5pt; color: var(--muted); margin-top: 1px; }

      .linkedin-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.5);
        z-index: 50;
        align-items: center;
        justify-content: center;
        padding: 20px;
      }
      .linkedin-modal.open { display: flex; }
      .linkedin-modal .box {
        background: #fff;
        max-width: 960px;
        width: 100%;
        min-height: 60vh;
        max-height: 85vh;
        display: flex;
        flex-direction: column;
        border-radius: 10px;
        overflow: hidden;
      }
      .linkedin-modal .box-head {
        padding: 12px 16px;
        border-bottom: 1px solid var(--rule);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .linkedin-modal .box-head h3 { margin: 0; font-size: 12pt; }
      .linkedin-modal textarea {
        flex: 1;
        width: 100%;
        min-height: 250px;
        border: 0;
        resize: vertical;
        padding: 16px;
        font-family: 'SF Mono', Menlo, Consolas, monospace;
        font-size: 9.5pt;
        line-height: 1.5;
        outline: none;
      }
      .resize-handle {
        height: 10px;
        cursor: ns-resize;
        background: #f0f0f0;
        border-radius: 0 0 10px 10px;
        flex: 0 0 auto;
      }
      .resize-handle:hover, .resize-handle.dragging { background: #eef4ff; }


      .theme-panel {
        position: relative;
        font-size: 10pt;
      }
      .theme-panel > summary {
        cursor: pointer;
        padding: 7px 12px;
        border: 1px solid var(--rule);
        background: #f7f7f7;
        border-radius: 6px;
        list-style: none;
        font-family: inherit;
        line-height: 1;
        user-select: none;
      }
      .theme-panel > summary::-webkit-details-marker { display: none; }
      .theme-panel[open] > summary { background: #efefef; }
      .theme-controls {
        position: absolute;
        top: 100%;
        right: 0;
        margin-top: 6px;
        background: #fff;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 12px 14px;
        box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
        z-index: 20;
        min-width: 280px;
        display: flex;
        flex-direction: column;
        gap: 10px;
      }
      .theme-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .theme-label {
        font-size: 9pt;
        font-weight: 700;
        color: var(--muted);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        flex: 0 0 70px;
      }
      .theme-presets {
        display: inline-flex;
        gap: 4px;
        flex-wrap: wrap;
      }
      .theme-presets button {
        font-family: inherit;
        font-size: 9.5pt;
        padding: 5px 10px;
        border: 1px solid var(--rule);
        background: #fafafa;
        color: var(--ink);
        border-radius: 5px;
        cursor: pointer;
        line-height: 1;
      }
      .theme-presets button[aria-pressed="true"] {
        background: var(--ink);
        color: #fff;
        border-color: var(--ink);
      }
      .theme-presets .swatch {
        display: inline-block;
        width: 9px;
        height: 9px;
        border-radius: 50%;
        margin-right: 5px;
        vertical-align: middle;
        border: 1px solid rgba(0,0,0,0.15);
      }
      .theme-picker {
        display: inline-flex;
        align-items: center;
        gap: 6px;
      }
      .theme-picker[hidden] { display: none; }
      .theme-picker input[type="color"] {
        width: 34px;
        height: 26px;
        padding: 0;
        border: 1px solid var(--rule);
        border-radius: 5px;
        background: transparent;
        cursor: pointer;
      }
      .theme-feedback {
        font-size: 9pt;
        font-weight: 600;
        align-self: center;
        letter-spacing: 0.02em;
      }
      .theme-feedback.error { color: #9b2020; }
      .theme-feedback.ok { color: #1f5736; }
      .theme-row label {
        font-size: 10pt;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
        white-space: nowrap;
      }
      .theme-row input[type="checkbox"] { margin: 0; }

      @page {
        margin: 0;
        size: auto;
      }

      @media print {
        :root {
          print-color-adjust: exact;
          -webkit-print-color-adjust: exact;
        }
        body { background: #fff; font-size: 11pt; margin: 0; padding: 0; }
        .toolbar, .linkedin-modal, .cv-cards, .cv-tabs { display: none !important; }
        .page {
          max-width: none;
          margin: 0;
          padding: 0.5in;
          -webkit-box-decoration-break: clone;
          box-decoration-break: clone;
          box-shadow: none;
          overflow: visible !important;
        }
        .lang { display: none !important; }
        .lang.active { display: block !important; }
        section { margin-top: 12px; }
        h1 { font-size: 20pt; }
        h2 { font-size: 12pt; }
        a { color: var(--ink); text-decoration: none; }
        .contactline, .job-head .job-dates, .edu-dates, .edu-note, .proj-meta, .bullets li.proj-url {
          color: var(--ink);
        }
        h1, h2, .skill-cat, .bullets li.proj-url { color: var(--accent) !important; }
        h2 { border-bottom-color: var(--accent) !important; }
      }

      /* ===== Adapted page ===== */
      .adapted-app {
        display: flex;
        min-height: calc(100vh - 64px);
        background: #f0f0f0;
      }
      .offer-sidebar {
        flex: 0 0 280px;
        background: #fff;
        border-right: 1px solid var(--rule);
        display: flex;
        flex-direction: column;
        height: calc(100vh - 64px);
        position: sticky;
        top: 64px;
      }
      .sidebar-header {
        padding: 16px;
        border-bottom: 1px solid var(--rule);
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .sidebar-header h2 { margin: 0; font-size: 14pt; border: 0; padding: 0; text-transform: none; letter-spacing: 0; }
      .back-link { font-size: 9pt; color: var(--muted); text-decoration: none; }
      .back-link:hover { color: var(--ink); }
      button.back-link {
        border: 0;
        background: transparent;
        font-family: inherit;
        cursor: pointer;
        padding: 0;
      }

      /* Tabs "CVs base" / "CVs adaptados" de Mis perfiles (Fase D). El estado vive en
         html[data-cv-tab]; el panel inactivo queda fuera del render y del print. */
      .cv-tabs {
        display: flex;
        gap: 6px;
        padding: 12px 20px 0;
        max-width: 8.5in;
        margin: 0 auto;
      }
      .cv-tab {
        border: 1px solid var(--rule);
        background: transparent;
        border-radius: 8px 8px 0 0;
        padding: 8px 16px;
        font-family: inherit;
        font-size: 10pt;
        color: var(--muted);
        cursor: pointer;
        transition: background 140ms ease-out, color 140ms ease-out, border-color 140ms ease-out;
      }
      .cv-tab:hover { color: var(--ink); }
      .cv-tab[aria-selected="true"] {
        background: var(--bg);
        border-color: var(--rule);
        border-bottom-color: var(--bg);
        color: var(--ink);
        font-weight: 600;
      }
      .cv-tab:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .cv-panel[data-tab="base"], .cv-panel[data-tab="adapted"] { display: none; }
      html[data-cv-tab="base"] .cv-panel[data-tab="base"],
      html[data-cv-tab="adapted"] .cv-panel[data-tab="adapted"] { display: block; }
      .offer-list { flex: 1; overflow-y: auto; padding: 8px; }
      .offer-card {
        width: 100%;
        text-align: left;
        background: transparent;
        border: 1px solid transparent;
        border-radius: 8px;
        padding: 10px 12px;
        cursor: pointer;
        font-family: inherit;
        margin-bottom: 4px;
        transition: background 140ms ease-out, border-color 140ms ease-out;
      }
      .offer-card:hover { background: #f5f5f5; }
      .offer-card.active { background: #eef4ff; border-color: #c8d8f0; }
      .offer-card-select {
        width: 100%;
        text-align: left;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        font-family: inherit;
        color: inherit;
      }
      .offer-card-header { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 2px; }
      .offer-card-empresa { font-weight: 700; font-size: 10pt; }
      .offer-card-score { font-size: 9pt; font-weight: 600; font-variant-numeric: tabular-nums; }
      .offer-card-score.high { color: #1f5736; }
      .offer-card-score.med { color: #8a6d00; }
      .offer-card-score.low { color: #9b2020; }
      .offer-card-rol { display: block; font-size: 9.5pt; color: var(--muted); margin-bottom: 4px; }
      .offer-card-meta { display: block; font-size: 8.5pt; color: var(--muted); text-transform: capitalize; }
      .offer-card-meta span { margin-right: 4px; }
      .offer-card-badge { display: block; font-size: 8.5pt; font-weight: 600; margin-top: 4px; }
      .offer-card-badge.has-adapted { color: #1f5736; }
      .offer-card-badge.badge-analizada { color: #8a6d00; }
      .offer-card-badge.badge-agregada { color: var(--muted); }
      .offer-card-badge.no-adapted { color: var(--muted); }
      .offer-actions { display: flex; gap: 6px; margin-top: 6px; }
      .offer-action-btn {
        font-family: inherit;
        font-size: 8.5pt;
        padding: 3px 10px;
        border-radius: 5px;
        border: 1px solid #b9c6dd;
        background: #eef4ff;
        color: #1a365d;
        cursor: pointer;
        transition: background 120ms ease-out;
      }
      .offer-action-btn:hover { background: #dfeaff; }
      .offer-action-btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .offer-action-btn:disabled:hover { background: #eef4ff; }
      .offer-action-btn.offer-action-manual { background: #f7f7f7; color: var(--muted); border-color: var(--rule); }
      .offer-action-btn.offer-action-manual:hover { background: #eee; }
      .sidebar-actions { display: flex; align-items: center; gap: 6px; }
      .add-offer-btn {
        font-family: inherit;
        font-size: 9.5pt;
        padding: 6px 12px;
        border-radius: 6px;
        border: 1px solid #b9c6dd;
        background: #eef4ff;
        color: #1a365d;
        font-weight: 600;
        cursor: pointer;
        transition: background 120ms ease-out;
      }
      .add-offer-btn:hover { background: #dfeaff; }
      .add-offer-btn:disabled { opacity: 0.45; cursor: not-allowed; }
      .offer-empty { padding: 20px 16px; text-align: center; color: var(--muted); font-size: 10pt; }
      .offer-empty p { margin-bottom: 8px; }
      .offer-empty code { background: #f0f0f0; padding: 1px 4px; border-radius: 3px; font-size: 9pt; }

      .offer-panels { flex: 1; overflow: hidden; }
      .offer-panel { display: none; height: calc(100vh - 64px); }
      .offer-panel.active { display: block; }
      .split-screen { display: flex; height: calc(100vh - 64px); }
      .split-left, .split-right {
        flex: 1;
        overflow-y: auto;
        border-right: 1px solid var(--rule);
      }
      .split-right { border-right: 0; background: #fff; }
      .split-header {
        position: sticky;
        top: 0;
        background: #fff;
        padding: 12px 20px;
        border-bottom: 1px solid var(--rule);
        z-index: 5;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .split-header h3 { margin: 0; font-size: 11pt; }
      .split-actions button { font-family: inherit; font-size: 9pt; padding: 5px 10px; border: 1px solid var(--rule); background: #f7f7f7; border-radius: 5px; cursor: pointer; }
      .split-actions button:hover { background: #efefef; }
      .split-content { padding: 20px; font-size: 10pt; line-height: 1.5; }
      .split-content.markdown-body h1, .split-content.markdown-body h2, .split-content.markdown-body h3 {
        font-size: 12pt;
        margin-top: 16px;
        margin-bottom: 6px;
      }
      .split-content.markdown-body h2 { border-bottom: 1px solid var(--rule); padding-bottom: 3px; }
      .split-content.markdown-body ul { padding-left: 20px; }
      .split-content.markdown-body li { margin-bottom: 4px; }
      .split-content.markdown-body code {
        background: #f0f0f0; padding: 1px 4px; border-radius: 3px; font-size: 9pt;
      }

      .adapted-cv section { margin-bottom: 16px; }
      .adapted-cv h1 { font-size: 18pt; margin: 0; }
      .adapted-cv h2 { font-size: 11pt; text-transform: uppercase; letter-spacing: 0.06em; border-bottom: 1px solid var(--ink); padding-bottom: 3px; margin-bottom: 6px; }
      .adapted-cv .skill-line { display: flex; gap: 8px; margin-bottom: 3px; }
      .adapted-cv .skill-cat { flex: 0 0 145px; font-weight: 700; }
      .adapted-empty { padding: 40px 20px; text-align: center; color: var(--muted); }
      .adapted-empty code { background: #f0f0f0; padding: 1px 4px; border-radius: 3px; }

      /* ===== Chips/badges de postulacion (Fase F): pills solo para etiquetas ===== */
      .chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: none;
        border-radius: 999px;
        padding: 2px 9px;
        font-size: 11px;
        color: var(--muted);
        background: color-mix(in srgb, var(--ink) 6%, var(--bg));
        white-space: nowrap;
      }
      .of-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 999px;
        padding: 2px 10px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
        text-transform: capitalize;
      }
      .of-badge-enviada {
        background: color-mix(in srgb, var(--accent) 14%, var(--bg));
        color: var(--accent);
      }
      .of-badge-confirmada {
        background: color-mix(in srgb, #1f7a4d 14%, var(--bg));
        color: #1a6540;
      }
      .of-badge-vetada {
        background: color-mix(in srgb, #b36b00 16%, var(--bg));
        color: #8a5200;
      }
      .of-badge-descartada {
        background: color-mix(in srgb, var(--ink) 7%, var(--bg));
        color: var(--muted);
      }
      .of-badge-borrador {
        background: transparent;
        color: var(--muted);
        border: 1px dashed var(--rule);
      }
      .of-badge-capturada {
        background: transparent;
        color: var(--accent);
        border: 1px solid var(--accent);
      }

      /* ===== Seccion "Postulacion" del panel del gestor (Cambio 3) ===== */
      .offer-post { padding: 16px 20px; border-bottom: 1px solid var(--rule); }
      .offer-post h4 {
        margin: 0 0 8px 0;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--muted);
      }
      .offer-post-head { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
      .offer-post-meta { font-size: 10px; color: var(--muted); }
      .offer-post p { margin: 8px 0 0 0; font-size: 10.5px; line-height: 1.5; }
      .offer-post .offer-post-label { color: var(--muted); }
      .offer-post .offer-post-quote {
        border-left: 3px solid #1f7a4d;
        background: color-mix(in srgb, var(--ink) 5%, var(--bg));
        padding: 8px 10px;
        border-radius: 4px;
        font-family: monospace;
        font-size: 10px;
        margin-top: 6px;
      }
      .offer-post .offer-post-row { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
      .offer-post .offer-post-empty { color: var(--muted); }

      /* ===== Ofertas manager: modales, tooltips, formulario, guardado ===== */
      .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 25, 45, 0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 200;
        animation: overlayFade 160ms ease-out;
      }
      @keyframes overlayFade { from { opacity: 0; } to { opacity: 1; } }
      .modal-box {
        background: #fff;
        border-radius: 10px;
        box-shadow: 0 18px 60px rgba(10, 20, 40, 0.25);
        width: min(920px, 94vw);
        max-height: 90vh;
        overflow-y: auto;
        padding: 18px 20px;
      }
      .modal-box.modal-form { width: min(860px, 94vw); }
      .modal-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
      .modal-head h3 { margin: 0; font-size: 13pt; }
      .modal-head-actions { display: flex; align-items: center; gap: 8px; }
      .modal-close {
        border: 1px solid var(--rule);
        background: #f7f7f7;
        border-radius: 6px;
        font-size: 13pt;
        line-height: 1;
        padding: 4px 10px;
        cursor: pointer;
      }
      .modal-close:hover { background: #eee; }
      .modal-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; align-items: center; }
      .modal-actions button {
        font-family: inherit;
        font-size: 10pt;
        padding: 8px 16px;
        border-radius: 6px;
        border: 1px solid var(--rule);
        background: #f7f7f7;
        cursor: pointer;
      }
      .modal-actions button:hover { background: #efefef; }
      .modal-actions button:disabled { opacity: 0.45; cursor: not-allowed; }
      .modal-actions .primary-btn { background: #1a365d; border-color: #1a365d; color: #fff; font-weight: 600; }
      .modal-actions .primary-btn:hover { background: #14294a; }
      .modal-actions .primary-btn:disabled { background: #93a3bd; border-color: #93a3bd; }
      .modal-actions .ai-btn { background: #eef4ff; border-color: #b9c6dd; color: #1a365d; font-weight: 600; }
      .modal-actions .ai-btn:hover { background: #dfeaff; }
      .modal-error { color: #9b2020; font-size: 9pt; margin: 6px 0; }
      .dev-only-note { font-size: 9pt; color: #8a6d00; margin-right: auto; }

      /* Modal IA de dos columnas */
      .modal-ai { width: min(1080px, 96vw); }
      .ai-columns { display: flex; gap: 14px; }
      .ai-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
      .ai-col-title { display: flex; justify-content: space-between; align-items: center; font-size: 9.5pt; font-weight: 600; margin-bottom: 6px; }
      .ai-prompt, .ai-paste {
        width: 100%;
        min-height: 340px;
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 8.5pt;
        line-height: 1.45;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 10px;
        resize: vertical;
        background: #fbfbfd;
      }
      .ai-prompt { color: #333; }
      .ai-paste:focus { border-color: #b9c6dd; outline: none; }

      /* Tooltip info */
      .info-tip { position: relative; display: inline-flex; }
      .info-tip-btn {
        width: 16px;
        height: 16px;
        border-radius: 50%;
        border: 1px solid #9fb2d2;
        background: #eef4ff;
        color: #1a365d;
        font-size: 8pt;
        font-weight: 700;
        font-style: italic;
        font-family: Georgia, serif;
        line-height: 1;
        cursor: help;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
      }
      .info-tip-btn:hover { background: #dfeaff; }
      .info-tip-pop {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        width: 340px;
        max-height: 320px;
        overflow-y: auto;
        background: #fff;
        color: #333;
        border: 1px solid var(--rule);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(10, 20, 40, 0.18);
        padding: 10px 12px;
        font-size: 9pt;
        line-height: 1.5;
        font-weight: 400;
        z-index: 300;
        white-space: normal;
        text-align: left;
      }

      /* Formulario agregar oferta */
      .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 14px; }
      .form-field { display: flex; flex-direction: column; gap: 4px; }
      .form-field.form-full { grid-column: 1 / -1; }
      .form-label { display: flex; align-items: center; gap: 6px; font-size: 9pt; font-weight: 600; color: #333; }
      .form-field input, .form-field select, .form-field textarea {
        font-family: inherit;
        font-size: 9.5pt;
        padding: 7px 10px;
        border: 1px solid var(--rule);
        border-radius: 6px;
        background: #fff;
      }
      .form-field textarea { resize: vertical; }
      .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: #9fb2d2; outline: none; }
      .form-err { color: #9b2020; font-size: 8.5pt; }
      .link-btn {
        border: 0;
        background: transparent;
        color: #1a365d;
        font-family: inherit;
        font-size: 8.5pt;
        cursor: pointer;
        text-decoration: underline;
        padding: 0;
      }
      .form-extras { margin-top: 12px; border-top: 1px dashed var(--rule); padding-top: 10px; }
      .form-extras summary { cursor: pointer; font-size: 9.5pt; font-weight: 600; color: var(--muted); }

      /* Guardado y verificacion */
      .modal-save { width: min(860px, 94vw); }
      .save-steps { margin: 0 0 12px; padding-left: 18px; font-size: 9.5pt; color: #333; }
      .save-steps li { margin-bottom: 4px; }
      .save-files { display: flex; flex-direction: column; gap: 8px; margin-bottom: 12px; }
      .save-file { border: 1px solid var(--rule); border-radius: 8px; overflow: hidden; }
      .save-file-head { display: flex; justify-content: space-between; align-items: center; background: #f7f8fb; padding: 7px 10px; }
      .save-file-head code { font-size: 8.5pt; }
      .save-file-actions { display: flex; gap: 10px; }
      .save-file-content {
        margin: 0;
        padding: 10px;
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 8pt;
        line-height: 1.45;
        max-height: 260px;
        overflow-y: auto;
        background: #fbfbfd;
        white-space: pre-wrap;
      }
      .save-actions { justify-content: flex-start; }
      .verify-result { font-size: 9.5pt; margin: 8px 0 0; }
      .verify-result.verify-ok { color: #1f5736; }
      .verify-result.verify-bad { color: #9b2020; }

      /* Analisis manual */
      .modal-manual { width: min(860px, 94vw); }
      .manual-report {
        width: 100%;
        font-family: ui-monospace, 'Cascadia Code', Consolas, monospace;
        font-size: 8.5pt;
        line-height: 1.5;
        border: 1px solid var(--rule);
        border-radius: 8px;
        padding: 10px;
        resize: vertical;
      }

      /* Tabs del split view */
      .split-tabs { display: flex; gap: 4px; }
      .split-tabs button {
        font-family: inherit;
        font-size: 9pt;
        padding: 4px 12px;
        border: 1px solid var(--rule);
        border-radius: 6px;
        background: #f7f7f7;
        cursor: pointer;
      }
      .split-tabs button.active { background: #eef4ff; border-color: #b9c6dd; color: #1a365d; font-weight: 600; }
      .split-header-right { justify-content: flex-end; }

      @media print {
        .toolbar { display: none !important; }
        .offer-sidebar, .split-left { display: none !important; }
        .split-header { display: none !important; }
        .split-right {
          overflow: visible !important;
          height: auto !important;
          padding: 0.5in !important;
          -webkit-box-decoration-break: clone;
          box-decoration-break: clone;
          border: 0 !important;
        }
        .split-content { overflow: visible !important; padding: 0 !important; }
        .offer-panel { display: none !important; height: auto !important; }
        .offer-panel.active { display: block !important; height: auto !important; }
        .split-screen { display: block !important; height: auto !important; }
        .adapted-app { display: block !important; min-height: auto !important; height: auto !important; }
        .offer-panels { overflow: visible !important; height: auto !important; }
        .adapted-cv { overflow: visible !important; }
        .adapted-cv article { padding: 0 !important; overflow: visible !important; }
        .split-right article.lang { display: none !important; }
        .split-right article.lang.active { display: block !important; }
      }
    </style>
  
  <!-- Modal de export de LinkedIn: compartido por todas las paginas con Toolbar -->
  <div class="linkedin-modal" id="linkedin-modal" role="dialog" aria-modal="true" aria-labelledby="linkedin-title">
    <div class="box">
      <div class="box-head">
        <h3 id="linkedin-title">LinkedIn Export</h3>
        <div class="box-head-right">
          <div class="toggle modal-lang-toggle" role="group" aria-label="Modal language">
            <button type="button" id="modal-btn-en" aria-pressed="true">EN</button>
            <button type="button" id="modal-btn-es" aria-pressed="false">ES</button>
          </div>
          <button type="button" id="btn-linkedin-close" aria-label="Close modal">Close</button>
        </div>
      </div>
      <div class="modal-tabs" role="tablist">
        <button type="button" role="tab" id="tab-sections" aria-selected="true" aria-controls="panel-sections">Sections</button>
        <button type="button" role="tab" id="tab-posts" aria-selected="false" aria-controls="panel-posts">Open-to-Work Post</button>
        <button type="button" role="tab" id="tab-connections" aria-selected="false" aria-controls="panel-connections">Connection Notes</button>
      </div>
      <div class="modal-panel active" id="panel-sections" role="tabpanel" aria-labelledby="tab-sections">
        <div class="textarea-wrap">
          <textarea id="linkedin-output" readonly></textarea>
          <button type="button" class="copy-btn" data-copy-target="linkedin-output">Copy</button>
        </div>
      </div>
      <div class="modal-panel" id="panel-posts" role="tabpanel" aria-labelledby="tab-posts" hidden>
        <div class="textarea-wrap">
          <textarea id="linkedin-post" readonly></textarea>
          <button type="button" class="copy-btn" data-copy-target="linkedin-post">Copy</button>
        </div>
      </div>
      <div class="modal-panel" id="panel-connections" role="tabpanel" aria-labelledby="tab-connections" hidden>
        <div class="connections-wrap">
          <div class="connections-name-row">
            <label for="conn-name">Recruiter name (replaces X):</label>
            <input type="text" id="conn-name" placeholder="Enter recruiter name" autocomplete="off" />
          </div>
          <div class="conn-msg">
            <div class="conn-msg-header">
              <span class="conn-msg-label">Draft A</span>
              <span class="conn-counter" data-counter-for="conn-msg-1">0/200</span>
            </div>
            <textarea class="conn-textarea" id="conn-msg-1"></textarea>
            <button type="button" class="copy-btn" data-copy-target="conn-msg-1">Copy</button>
          </div>
          <div class="conn-msg">
            <div class="conn-msg-header">
              <span class="conn-msg-label">Draft B</span>
              <span class="conn-counter" data-counter-for="conn-msg-2">0/200</span>
            </div>
            <textarea class="conn-textarea" id="conn-msg-2"></textarea>
            <button type="button" class="copy-btn" data-copy-target="conn-msg-2">Copy</button>
          </div>
          <div class="conn-msg">
            <div class="conn-msg-header">
              <span class="conn-msg-label">Draft C</span>
              <span class="conn-counter" data-counter-for="conn-msg-3">0/200</span>
            </div>
            <textarea class="conn-textarea" id="conn-msg-3"></textarea>
            <button type="button" class="copy-btn" data-copy-target="conn-msg-3">Copy</button>
          </div>
        </div>
      </div>
      <div class="resize-handle" title="Drag to resize"></div>
    </div>
  </div>
  <script>
    import '../scripts/toolbar';
  </script>
</body>
