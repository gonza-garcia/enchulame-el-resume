---
import Layout from '../layouts/Layout.astro';
import Toolbar from '../components/Toolbar.astro';
import OffersManager from '../islands/offers-manager/OffersManager';
import { listOffers, readOfferDetail, stripFrontmatter, type OfferListing } from '../lib/job-offers';
import { resumeSchema } from '../schemas/resume';
import { loadProfile, nameInitials } from '../lib/profile';
import { marked } from 'marked';

const listings: OfferListing[] = listOffers();
const { profile } = loadProfile();
const defaultPositioning = profile.positionings[0];

const views = listings.map((listing) => {
  const detail = readOfferDetail(listing.slug);
  const offerHtml = marked.parse(stripFrontmatter(detail?.offerRaw ?? '')) as string;
  const reportHtml = detail?.reportRaw
    ? (marked.parse(stripFrontmatter(detail.reportRaw)) as string)
    : null;
  let adaptedResume = null;
  if (detail?.adaptedResume) {
    const parsed = resumeSchema.safeParse(detail.adaptedResume);
    if (parsed.success) adaptedResume = parsed.data;
  }
  return { listing, offerHtml, reportHtml, adaptedResume };
});
---

<Layout title={`Adapted Resumes - ${profile.identity.name.en}`}>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5/github-markdown-light.css" />

  <Toolbar
    idPrefix=""
    brand={{
      mark: nameInitials(profile.identity.name.en),
      name: profile.identity.name.en,
      role: defaultPositioning.title.en
    }}
    pdfTitle={`${profile.identity.name.en} - CV`}
    showTheme={true}
    navLinks={[
      { href: '/adapted/', label: 'CVs adaptados' },
      { href: '/interview/', label: 'Prep entrevistas' },
      { href: '/learning/', label: 'Plan de estudios' }
    ]}
  />

  <OffersManager client:load offers={views} isDev={import.meta.env.DEV} />
</Layout>
