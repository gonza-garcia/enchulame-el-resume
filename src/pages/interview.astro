---
import { codeToHtml } from 'shiki';
import '../styles/ui.css';
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import InterviewPrep from '../islands/interview-prep/InterviewPrep';
import { loadProfile, nameInitials } from '../lib/profile';
import { loadLearningPlan } from '../lib/learning-plan';
import { assertReviewPlanQuestionIds, loadReviewPlans } from '../lib/interview-review-plan';
import {
  interviewQuestionBankSchema,
  interviewTrickyQuizSchema,
  type InterviewCodeBlock,
  type InterviewQuestionBank,
  type InterviewTrickyQuiz
} from '../schemas/interview-questions';

const { profile } = loadProfile();
const { plan: learningPlan } = loadLearningPlan();

const planLinks: Record<
  string,
  { phaseId: string; phaseTitle: { es: string; en: string }; skillNames: { es: string; en: string }[] }
> = {};
for (const phase of learningPlan.phases) {
  if (!phase.interviewArea) continue;
  planLinks[phase.interviewArea] = {
    phaseId: phase.id,
    phaseTitle: phase.title,
    skillNames: phase.skillIds
      .map((skillId) => learningPlan.skills.find((skill) => skill.id === skillId)?.name)
      .filter((name): name is { es: string; en: string } => Boolean(name))
  };
}

const modules = import.meta.glob('../content/interview-questions/*.json', {
  eager: true,
  import: 'default'
});

const parsedBanks: InterviewQuestionBank[] = [];
const parsedQuizzes: InterviewTrickyQuiz[] = [];

for (const [file, value] of Object.entries(modules)) {
  if (file.endsWith('.tricky-quiz.json')) {
    parsedQuizzes.push(interviewTrickyQuizSchema.parse(value));
  } else {
    parsedBanks.push(interviewQuestionBankSchema.parse(value));
  }
}

if (parsedBanks.length !== 24 || parsedQuizzes.length !== 24) {
  throw new Error(`Interview content expected 24 banks and 24 quiz files, received ${parsedBanks.length} and ${parsedQuizzes.length}.`);
}

const AREA_LABELS: Record<string, string> = {
  'javascript-typescript': 'JavaScript y TypeScript',
  'html-css-accessibility': 'HTML, CSS y accesibilidad',
  'browser-web-apis': 'Navegador y Web APIs',
  'web-performance': 'Performance web',
  'mobile-cross-platform': 'Mobile y cross-platform',
  'react-frameworks-ui': 'React y frameworks UI',
  'state-data-fetching': 'Estado y data fetching',
  'styling-design-systems': 'Estilos y design systems',
  'ui-components-machine-coding': 'Componentes UI y machine coding',
  'networking-apis': 'Redes y APIs',
  'backend-data': 'Backend y datos',
  'testing-quality': 'Testing y calidad',
  'security-auth': 'Seguridad y auth',
  observability: 'Observabilidad',
  'architecture-build': 'Arquitectura frontend y build',
  'system-design-frontend': 'System design frontend',
  'dsa-frontend': 'DSA frontend',
  'git-cicd-cloud': 'Git, CI/CD y cloud',
  'python-backend-cloud': 'Python, backend y cloud',
  'llm-fundamentals': 'LLM y prompting',
  'rag-retrieval': 'RAG y retrieval',
  'agents-mcp': 'Agentes y MCP',
  'evals-production': 'Evals y producción',
  'behavioral-career': 'Behavioral y carrera'
};

const AREA_GROUPS = [
  { label: 'Lenguaje y resolución', areas: ['javascript-typescript', 'dsa-frontend'] },
  { label: 'Plataforma web', areas: ['html-css-accessibility', 'browser-web-apis'] },
  { label: 'UI y producto', areas: ['react-frameworks-ui', 'styling-design-systems', 'ui-components-machine-coding'] },
  { label: 'Performance y dispositivos', areas: ['web-performance', 'mobile-cross-platform'] },
  { label: 'Arquitectura', areas: ['architecture-build', 'system-design-frontend'] },
  { label: 'Datos y APIs', areas: ['state-data-fetching', 'networking-apis', 'backend-data'] },
  { label: 'Entrega, calidad y confianza', areas: ['git-cicd-cloud', 'testing-quality', 'security-auth', 'observability'] },
  { label: 'Carrera y futuro', areas: ['behavioral-career'] },
  {
    label: 'AI engineering (por fases del plan)',
    areas: [
      'python-backend-cloud',
      'llm-fundamentals',
      'rag-retrieval',
      'agents-mcp',
      'evals-production'
    ]
  }
];

const trickyByArea = new Map(parsedQuizzes.map((quiz) => [quiz.area, quiz]));
const highlightedHtmlCache = new Map<string, string>();

const bankQuestionIds = new Set(parsedBanks.flatMap((bank) => bank.questions.map((question) => question.id)));
for (const quiz of parsedQuizzes) {
  for (const group of quiz.trickies) {
    if (!bankQuestionIds.has(group.id)) {
      throw new Error(`Tricky group "${group.id}" of ${quiz.area} does not match any bank question.`);
    }
  }
}

// Planes de repaso por oferta (ADR-0035): se validan en build contra el banco.
assertReviewPlanQuestionIds(loadReviewPlans(), bankQuestionIds);

const SHIKI_LANGUAGE_ALIASES: Record<string, string> = {
  ts: 'typescript',
  tsx: 'tsx',
  js: 'javascript',
  jsx: 'jsx',
  text: 'text'
};

function escapeHtml(value: string): string {
  return value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;')
    .replaceAll("'", '&#39;');
}

async function highlight(code: string, language: string): Promise<string> {
  const key = `${language}\u0000${code}`;
  const cached = highlightedHtmlCache.get(key);
  if (cached) return cached;

  try {
    const html = await codeToHtml(code, {
      lang: SHIKI_LANGUAGE_ALIASES[language] ?? language,
      theme: 'github-dark'
    });
    highlightedHtmlCache.set(key, html);
    return html;
  } catch {
    const fallback = `<pre><code>${escapeHtml(code)}</code></pre>`;
    highlightedHtmlCache.set(key, fallback);
    return fallback;
  }
}

async function renderCodeBlock(block: InterviewCodeBlock) {
  return {
    language: block.language,
    code: block.code,
    caption: block.caption,
    html: await highlight(block.code, block.language)
  };
}

const questions = (
  await Promise.all(
    parsedBanks.flatMap((bank) =>
      bank.questions.map(async (question) => {
        const quiz = trickyByArea.get(bank.area);
        const followUps = quiz?.trickies.find((group) => group.id === question.id)?.items ?? [];
        return {
          ...question,
          trickies: followUps,
          codeBlocks: await Promise.all(question.codeBlocks.map((block) => renderCodeBlock(block)))
        };
      })
    )
  )
).sort((left, right) => left.id.localeCompare(right.id));

const quizzes = await Promise.all(
  parsedQuizzes.map(async (quiz) => ({
    area: quiz.area,
    mcqs: quiz.quiz.mcqs,
    scenarios: await Promise.all(
      quiz.quiz.scenarios.map(async (scenario) => ({
        ...scenario,
        code: await renderCodeBlock({ ...scenario.code, caption: 'Código del escenario' })
      }))
    )
  }))
);

const sources = Array.from(
  new Map(
    parsedBanks.flatMap((bank) => bank.questions.flatMap((question) => question.sources))
      .map((source) => [source.url, source])
  ).values()
).sort((left, right) => left.label.localeCompare(right.label));
---

<Layout title={`Prep entrevistas - ${profile.identity.name.en}`}>
  {/* Navbar slim de 3 destinos (Fase D): brand + links, sin controles de export/tema
      (el Toolbar completo vive en "Mis perfiles"). */}
  <div class="toolbar">
    <SiteNav
      brand={{
        mark: nameInitials(profile.identity.name.en),
        name: profile.identity.name.en,
        role: profile.positionings[0].title.en
      }}
    />
    <div class="spacer"></div>
  </div>
  <InterviewPrep
    client:load
    questions={questions}
    quizzes={quizzes}
    areaLabels={AREA_LABELS}
    areaGroups={AREA_GROUPS}
    sources={sources}
    planLinks={planLinks}
    reviewPlans={loadReviewPlans()}
  />

  <style is:global>
    .interview-app {
      --iv-ink: #17191d;
      --iv-muted: #686a70;
      --iv-paper: #f1ede5;
      --iv-card: #fffdf8;
      --iv-line: #d9d3c8;
      --iv-soft-line: #e8e2d8;
      --iv-accent: #c9f36b;
      --iv-blue: #3559ff;
      --iv-shadow: 0 18px 45px rgba(40, 35, 24, 0.08);
      min-height: 100vh;
      background: var(--iv-paper);
      color: var(--iv-ink);
      font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
      line-height: 1.45;
    }

    .interview-app * { box-sizing: border-box; }
    .interview-app button,
    .interview-app input,
    .interview-app select { font: inherit; }
    .interview-app button { color: inherit; }
    .interview-app a { color: inherit; }
    .interview-app h1,
    .interview-app h2,
    .interview-app h3,
    .interview-app h4,
    .interview-app p { margin: 0; }

    .interview-header {
      background: var(--iv-ink);
      color: #faf8f2;
      overflow: hidden;
      position: relative;
    }

    .interview-header::after {
      background: var(--iv-accent);
      bottom: -80px;
      content: '';
      height: 110px;
      opacity: 0.9;
      position: absolute;
      right: -20px;
      transform: rotate(-8deg);
      width: 46%;
    }

    .interview-header-inner {
      margin: 0 auto;
      max-width: 1600px;
      padding: 28px clamp(20px, 4vw, 64px) 58px;
      position: relative;
      z-index: 1;
    }

    .interview-brand-row,
    .interview-heading,
    .detail-topline,
    .detail-meta,
    .results-toolbar,
    .section-heading-row,
    .card-topline,
    .card-footer,
    .detail-bottom,
    .code-label {
      align-items: center;
      display: flex;
    }

    .interview-brand-row { gap: 12px; }
    .interview-back {
      color: #d6d6d0;
      font-size: 0.78rem;
      letter-spacing: 0.03em;
      text-decoration: none;
    }
    .interview-back:hover { color: var(--iv-accent); }
    .header-rule { background: #595b61; height: 1px; width: 40px; }
    .header-label {
      color: var(--iv-accent);
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .interview-heading {
      align-items: flex-end;
      gap: 32px;
      justify-content: space-between;
      margin-top: 68px;
    }
    .interview-app .interview-heading h1 {
      color: #faf8f2;
      font-size: clamp(2.8rem, 7vw, 6.4rem);
      font-weight: 700;
      letter-spacing: -0.07em;
      line-height: 0.9;
      max-width: 760px;
    }
    .eyebrow {
      color: var(--iv-muted);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.14em;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    .interview-header .eyebrow { color: var(--iv-accent); }
    .header-description {
      color: #c3c2bb;
      font-size: 1rem;
      margin-top: 22px;
      max-width: 530px;
    }
    .header-stats {
      display: flex;
      gap: clamp(16px, 3vw, 40px);
      padding-bottom: 3px;
      white-space: nowrap;
    }
    .header-stats div { display: flex; flex-direction: column; gap: 3px; }
    .header-stats strong {
      color: var(--iv-accent);
      font-size: 1.7rem;
      letter-spacing: -0.04em;
      line-height: 1;
    }
    .header-stats span {
      color: #b1b1aa;
      font-size: 0.68rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .interview-layout {
      display: grid;
      gap: clamp(18px, 3vw, 38px);
      grid-template-columns: minmax(230px, 280px) minmax(0, 1fr);
      margin: 0 auto;
      max-width: 1600px;
      padding: 24px clamp(20px, 4vw, 64px) 80px;
    }

    .interview-filters {
      align-self: start;
      background: rgba(255, 253, 248, 0.7);
      border: 1px solid var(--iv-line);
      border-radius: 2px;
      max-height: calc(100vh - 32px);
      overflow-y: auto;
      padding: 20px 18px;
      position: sticky;
      top: 16px;
    }
    .filters-heading { align-items: flex-start; display: flex; justify-content: space-between; }
    .filters-heading h2,
    .section-heading-row h2 {
      font-size: 1.25rem;
      letter-spacing: -0.04em;
    }
    .text-button,
    .practice-link {
      background: transparent;
      border: 0;
      cursor: pointer;
      font-size: 0.73rem;
      font-weight: 700;
      padding: 3px 0;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .text-button { color: var(--iv-blue); }
    .text-button:hover,
    .practice-link:hover { color: var(--iv-ink); }
    .search-field,
    .sort-field { display: flex; flex-direction: column; gap: 7px; }
    .search-field { margin-top: 22px; }
    /* Disparador de la búsqueda global (cambio 6). */
    .global-search-trigger {
      align-items: center;
      background: var(--iv-ink);
      border: 0;
      color: #fff;
      cursor: pointer;
      display: flex;
      font-size: 0.72rem;
      font-weight: 800;
      gap: 8px;
      justify-content: space-between;
      letter-spacing: 0.08em;
      margin-top: 20px;
      padding: 10px 12px;
      text-transform: uppercase;
      width: 100%;
    }
    .global-search-trigger:hover { background: var(--iv-blue); }
    .global-search-trigger kbd {
      background: rgba(255, 255, 255, 0.14);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 3px;
      color: #fff;
      font-family: inherit;
      font-size: 0.62rem;
      letter-spacing: 0.04em;
      padding: 2px 5px;
      text-transform: none;
    }
    /* Resultados de la búsqueda global (Command). */
    .search-hint,
    .search-empty {
      color: var(--ui-muted-foreground);
      font-size: 0.8rem;
      padding: 18px 12px;
      text-align: center;
    }
    .search-result-row { align-items: center; display: flex; gap: 6px; padding: 0 4px; }
    .search-result-main { flex: 1; min-width: 0; }
    .search-result-copy { display: flex; flex: 1; flex-direction: column; gap: 2px; min-width: 0; }
    .search-result-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .search-result-meta { color: var(--ui-muted-foreground); font-size: 0.68rem; }
    .search-result-action {
      background: none;
      border: 1px solid var(--ui-border);
      border-radius: 3px;
      color: var(--ui-foreground);
      cursor: pointer;
      flex: none;
      font-size: 0.64rem;
      padding: 4px 6px;
    }
    .search-result-action:hover { background: var(--ui-muted); }
    .search-field > span,
    .sort-field > span {
      color: var(--iv-muted);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .search-field input,
    .sort-field select {
      background: #fffefa;
      border: 1px solid var(--iv-line);
      border-radius: 0;
      color: var(--iv-ink);
      min-height: 38px;
      outline: none;
      padding: 8px 10px;
      width: 100%;
    }
    .search-field input:focus,
    .sort-field select:focus { border-color: var(--iv-blue); box-shadow: 0 0 0 2px rgba(53, 89, 255, 0.12); }
    .sr-only {
      border: 0;
      clip-path: inset(50%);
      height: 1px;
      margin: -1px;
      overflow: hidden;
      padding: 0;
      position: absolute;
      white-space: nowrap;
      width: 1px;
    }
    .filter-group { border: 0; margin: 20px 0 0; padding: 0; }
    .filter-group legend {
      color: var(--iv-ink);
      font-size: 0.74rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      margin-bottom: 8px;
      text-transform: uppercase;
    }
    .checkbox-list,
    .area-groups { display: grid; gap: 7px; }
    .area-groups { gap: 13px; }
    /* Árbol de áreas: "Todas las áreas" > grupo (plegable) > sub-áreas. */
    .area-filter-group > .checkbox-row {
      border-bottom: 1px solid var(--iv-soft-line);
      margin: 11px 0 12px;
      padding-bottom: 12px;
    }
    .area-group { display: grid; gap: 6px; }
    .area-group-head { align-items: center; display: flex; gap: 8px; }
    .area-group-head .checkbox-row { flex: 1; }
    .area-group-head .checkbox-row span {
      color: var(--iv-muted);
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .area-fold {
      background: none;
      border: 0;
      color: var(--iv-muted);
      cursor: pointer;
      padding: 2px;
    }
    .area-fold:hover { color: var(--iv-ink); }
    .area-fold-mark { display: inline-flex; font-size: 0.72rem; line-height: 1; }
    .area-fold-mark::before { content: '\25BE'; }
    .area-fold[aria-expanded='false'] .area-fold-mark::before { content: '\25B8'; }
    .area-group-areas { display: grid; gap: 6px; }
    .checkbox-row,
    .switch-row { align-items: flex-start; cursor: pointer; display: flex; gap: 8px; }
    .checkbox-row { color: #45474c; font-size: 0.78rem; line-height: 1.25; }
    .switch-row { color: #33353a; font-size: 0.8rem; margin-top: 9px; }
    .checkbox-row input,
    .switch-row input { accent-color: var(--iv-blue); margin: 2px 0 0; }
    .style-picker { display: flex; flex-wrap: wrap; gap: 5px; }
    .style-choice {
      background: #fffefa;
      border: 1px solid var(--iv-line);
      cursor: pointer;
      font-size: 0.7rem;
      padding: 6px 8px;
    }
    .style-choice.active { background: var(--iv-ink); border-color: var(--iv-ink); color: #fff; }

    .interview-main { min-width: 0; }
    .results-toolbar { justify-content: space-between; margin-bottom: 14px; }
    .results-count { color: var(--iv-muted); font-size: 0.86rem; }
    .results-count strong { color: var(--iv-ink); font-size: 1.3rem; letter-spacing: -0.04em; }
    .sort-controls { align-items: flex-end; display: flex; gap: 6px; }
    .sort-field { min-width: 210px; }
    .sort-field select { min-height: 34px; padding: 6px 9px; }
    .reshuffle-button {
      background: var(--iv-card);
      border: 1px solid var(--iv-ink);
      cursor: pointer;
      font-size: 0.7rem;
      font-weight: 700;
      min-height: 34px;
      padding: 6px 10px;
    }
    .reshuffle-button:hover { background: var(--iv-ink); color: #fff; }
    .toolbar-tools { align-items: flex-end; display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
    .progress-tools { align-items: center; display: flex; flex-wrap: wrap; gap: 5px; }
    .progress-count { color: var(--iv-muted); font-size: 0.72rem; margin-right: 3px; }
    .progress-btn {
      background: var(--iv-card);
      border: 1px solid var(--iv-line);
      cursor: pointer;
      font-size: 0.7rem;
      font-weight: 700;
      min-height: 34px;
      padding: 6px 9px;
    }
    .progress-btn:hover { border-color: var(--iv-ink); }
    .progress-feedback {
      background: var(--iv-card);
      border-left: 3px solid var(--iv-blue);
      color: var(--iv-ink);
      font-size: 0.82rem;
      margin-bottom: 12px;
      padding: 8px 10px;
    }
    .progress-block {
      border-top: 1px solid var(--iv-soft-line);
      margin-top: 24px;
      padding-top: 18px;
    }
    .status-picker { display: flex; flex-wrap: wrap; gap: 5px; }
    .status-choice {
      background: var(--iv-card);
      border: 1px solid var(--iv-line);
      cursor: pointer;
      font-size: 0.78rem;
      font-weight: 700;
      padding: 7px 11px;
    }
    .status-choice:hover { border-color: var(--iv-ink); }
    .status-choice.active { background: var(--iv-blue); border-color: var(--iv-blue); color: #fff; }
    .note-field { display: flex; flex-direction: column; gap: 6px; margin-top: 10px; }
    .note-field > span {
      color: var(--iv-muted);
      font-size: 0.68rem;
      font-weight: 800;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .note-field textarea {
      background: var(--iv-card);
      border: 1px solid var(--iv-line);
      color: var(--iv-ink);
      font-family: inherit;
      font-size: 0.85rem;
      line-height: 1.45;
      padding: 9px 10px;
      resize: vertical;
      width: 100%;
    }
    .note-field textarea:focus { border-color: var(--iv-blue); outline: none; }

    .detail-panel {
      background: var(--iv-card);
      border: 1px solid var(--iv-ink);
      box-shadow: var(--iv-shadow);
      padding: clamp(20px, 3vw, 34px);
    }
    .empty-detail { border-color: var(--iv-line); box-shadow: none; }
    .empty-detail h2 { font-size: 1.65rem; letter-spacing: -0.05em; margin-bottom: 8px; }
    .empty-detail p:last-child { color: var(--iv-muted); }
    .detail-topline { gap: 15px; justify-content: space-between; }
    .detail-meta { flex-wrap: wrap; gap: 8px; }
    .level-pill {
      background: var(--level-soft);
      color: var(--level-color);
      display: inline-flex;
      font-size: 0.65rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      padding: 5px 7px;
      text-transform: uppercase;
    }
    .detail-area { font-size: 0.78rem; font-weight: 700; }
    .detail-frequency { color: var(--iv-muted); font-size: 0.72rem; }
    .practice-link { color: var(--iv-blue); white-space: nowrap; }
    .detail-topic {
      color: var(--iv-muted);
      font-size: 0.72rem;
      letter-spacing: 0.08em;
      margin-top: 23px !important;
      text-transform: uppercase;
    }
    .detail-panel h2 {
      font-size: clamp(1.45rem, 2.5vw, 2.35rem);
      letter-spacing: -0.055em;
      line-height: 1.02;
      margin-top: 9px;
      max-width: 950px;
    }
    .interview-app .answer-toggle {
      align-items: center;
      background: var(--iv-ink);
      border: 0;
      color: #fff;
      cursor: pointer;
      display: flex;
      font-size: 0.75rem;
      font-weight: 800;
      justify-content: space-between;
      letter-spacing: 0.08em;
      margin-top: 24px;
      padding: 11px 13px;
      text-transform: uppercase;
      width: min(100%, 230px);
