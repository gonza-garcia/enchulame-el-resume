---
import Layout from '../layouts/Layout.astro';
import SiteNav from '../components/SiteNav.astro';
import LearningPlanIsland from '../islands/learning-plan/LearningPlanIsland';
import { loadLearningPlan } from '../lib/learning-plan';
import { loadProfile, nameInitials } from '../lib/profile';
import { buildProfileReadModel } from '../lib/profile-read-model';
import { LEARNING_READING_LIST } from '../lib/learning-reading-list';

const { plan } = loadLearningPlan();
const { profile } = loadProfile();
const readModel = buildProfileReadModel(profile);
const positionings = profile.positionings.map((positioning) => ({
  id: positioning.id,
  title: positioning.title
}));
---

<Layout title={`Plan de estudios - ${profile.identity.name.en}`}>
  {/* Navbar slim de 3 destinos (Fase D): brand + links, sin controles de export/tema
      (el Toolbar completo vive en "Mis perfiles"). */}
  <div class="toolbar">
    <SiteNav
      brand={{
        mark: nameInitials(profile.identity.name.en),
        name: profile.identity.name.en,
        role: positionings[0].title.en
      }}
    />
    <div class="spacer"></div>
  </div>
  <LearningPlanIsland
    client:load
    plan={plan}
    positionings={positionings}
    readingList={LEARNING_READING_LIST}
    profile={readModel}
  />

  <style is:global>
    .learning-app {
      max-width: 1080px;
      margin: 0 auto;
      padding: 1.5rem 1.25rem 4rem;
      color: var(--ink);
    }

    .learning-header-row {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 1rem;
    }

    .learning-lang {
      display: inline-flex;
      gap: 0.35rem;
    }

    .learning-lang-btn {
      min-width: 2.6rem;
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--bg);
      color: var(--muted);
      cursor: pointer;
      font-size: 0.85rem;
    }

    .learning-lang-btn[aria-pressed='true'] {
      border-color: var(--accent);
      color: var(--accent);
      font-weight: 600;
    }

    .learning-eyebrow {
      margin: 1.5rem 0 0.25rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-size: 0.75rem;
      color: var(--muted);
    }

    .learning-app h1 {
      margin: 0 0 0.5rem;
      font-size: 1.9rem;
      line-height: 1.2;
    }

    .learning-positioning {
      margin: 0 0 1.5rem;
      color: var(--muted);
      font-size: 0.95rem;
    }

    .learning-progress-block {
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.75rem 1rem;
      margin: 0 0 1.25rem;
    }

    .learning-progress-count {
      margin: 0 0 0.5rem;
      font-size: 0.95rem;
    }

    .learning-progress-tools {
      display: flex;
      gap: 0.5rem;
    }

    .learning-progress-btn {
      padding: 0.35rem 0.85rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--bg);
      color: var(--ink);
      cursor: pointer;
      font-size: 0.85rem;
    }

    .learning-progress-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    .learning-progress-feedback {
      margin: 0.5rem 0 0;
      font-size: 0.85rem;
      color: var(--muted);
    }

    .learning-status,
    .learning-gate {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.55rem;
    }

    .learning-gate-label {
      font-size: 0.85rem;
      color: var(--muted);
      margin-right: 0.25rem;
    }

    .learning-status-btn,
    .learning-gate-btn {
      padding: 0.25rem 0.6rem;
      border: 1px solid var(--rule);
      border-radius: 4px;
      background: var(--bg);
      color: var(--muted);
      cursor: pointer;
      font-size: 0.78rem;
    }

    .learning-status-btn[aria-pressed='true'],
    .learning-gate-btn[aria-pressed='true'] {
      border-color: var(--accent);
      color: var(--accent);
      font-weight: 600;
    }

    .learning-app h2 {
      margin: 2.25rem 0 0.75rem;
      font-size: 1.35rem;
      border-bottom: 2px solid var(--accent);
      padding-bottom: 0.35rem;
    }

    .learning-app h3 {
      margin: 0 0 0.35rem;
      font-size: 1.1rem;
    }

    .learning-app h4 {
      margin: 0 0 0.4rem;
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }

    .learning-app h5 {
      margin: 0 0 0.35rem;
      font-size: 1rem;
    }

    .learning-profile-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }

    .learning-profile-list {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .learning-profile-list li {
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.55rem 0.75rem;
      margin: 0.45rem 0;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .learning-profile-level {
      font-size: 0.82rem;
      color: var(--muted);
    }

    .learning-profile-demand {
      font-size: 0.78rem;
      color: var(--muted);
    }

    .learning-profile-suggestion {
      font-size: 0.82rem;
      color: var(--accent);
    }

    .learning-profile-empty {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .learning-role-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.85rem;
    }

    .learning-role {
      border: 1px solid var(--rule);
      border-left: 4px solid var(--accent);
      border-radius: 6px;
      padding: 0.9rem 1rem;
    }

    .learning-role p {
      margin: 0.25rem 0;
    }

    .learning-role-phase {
      font-size: 0.9rem;
      color: var(--muted);
    }

    .learning-phase {
      border: 1px solid var(--rule);
      border-radius: 8px;
      padding: 1.1rem 1.25rem;
      margin: 1rem 0;
    }

    .learning-phase-header {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.65rem;
    }

    .learning-phase-order {
      background: var(--accent);
      color: var(--bg);
      border-radius: 4px;
      padding: 0.15rem 0.55rem;
      font-size: 0.8rem;
      font-weight: 600;
    }

    .learning-phase-duration {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .learning-phase-quiz-link {
      margin: 0.5rem 0 0;
      font-size: 0.92rem;
    }

    .learning-phase-quiz-link a {
      color: var(--accent);
      font-weight: 600;
    }

    .learning-phase-roles {
      margin: 0.5rem 0;
      font-size: 0.92rem;
    }

    .learning-chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin: 0.55rem 0;
    }

    .learning-chip {
      display: inline-flex;
      flex-direction: column;
      gap: 0.1rem;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.3rem 0.55rem;
      background: var(--bg);
      max-width: 100%;
    }

    .learning-chip-name {
      font-size: 0.82rem;
      font-weight: 600;
    }

    .learning-chip-demand {
      font-size: 0.72rem;
      color: var(--muted);
    }

    .learning-phase-body {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
      margin-top: 0.75rem;
    }

    .learning-topics {
      margin: 0;
      padding-left: 1.15rem;
    }

    .learning-topics li {
      margin: 0.25rem 0;
    }

    .learning-phase-project,
    .learning-phase-gate {
      margin: 0.65rem 0 0;
      font-size: 0.95rem;
    }

    .learning-phase-gate {
      border-left: 3px solid var(--accent);
      padding-left: 0.6rem;
    }

    .learning-resource {
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.75rem 0.85rem;
      margin: 0.6rem 0;
    }

    .learning-resource-title a {
      color: var(--accent);
    }

    .learning-resource-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.55rem;
      margin: 0.3rem 0;
      font-size: 0.82rem;
      color: var(--muted);
    }

    .learning-resource-meta span {
      border-right: 1px solid var(--rule);
      padding-right: 0.55rem;
    }

    .learning-resource-meta span:last-child {
      border-right: none;
    }

    .learning-resource-confidence {
      margin: 0.25rem 0;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .learning-resource-opinion {
      margin: 0.35rem 0;
      font-size: 0.92rem;
    }

    .learning-anti ul,
    .learning-exit ul {
      margin: 0;
      padding-left: 1.15rem;
    }

    .learning-anti li,
    .learning-exit li {
      margin: 0.4rem 0;
    }

    .learning-reading-note {
      color: var(--muted);
      font-size: 0.9rem;
    }

    .learning-reading-list {
      padding-left: 1.15rem;
    }

    .learning-reading-list li {
      margin: 0.65rem 0;
    }

    .learning-reading-list a {
      color: var(--accent);
      font-weight: 600;
    }

    .learning-reading-list p {
      margin: 0.2rem 0 0;
      font-size: 0.9rem;
      color: var(--muted);
    }

    @media (max-width: 820px) {
      .learning-phase-body {
        grid-template-columns: 1fr;
      }

      .learning-profile-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</Layout>
